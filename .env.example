CAP_DAILY_ACQUISITION_TARGET=1000
CAP_DAILY_EMAIL_OUTREACH_LIMIT=250
CAP_EMAIL_SEND_ENABLED=false
CAP_WHATSAPP_SEND_ENABLED=false
